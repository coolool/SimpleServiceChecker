<Window x:Class="SimpleServiceChecker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Starling Service Checker"
        Width="1366"
        Height="768"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <wv2:WebView2 x:Name="WebView" />
        <Border x:Name="LoadingOverlay" Background="#FFF4E7D5">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#FF5E4635" Text="Starling Service Checker" />
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="#FF705B4A" Text="Starting service checker…" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
